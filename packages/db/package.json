{
  "name": "@nabd/db",
  "version": "0.0.0",
  "private": true,
  "description": "SQL migrations (node-pg-migrate, plain SQL), seed and typed query helpers for TimescaleDB.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "default": "./dist/credentials.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate": "node-pg-migrate --migrations-dir migrations --use-glob --migration-file-language sql --envPath ../../.env",
    "migrate:up": "pnpm migrate up",
    "migrate:down": "pnpm migrate down",
    "credentials": "tsx src/cli/credentials.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "pg": "8.23.1",
    "@nabd/shared": "workspace:*",
    "argon2": "0.45.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0",
    "tsx": "4.23.15",
    "@testcontainers/postgresql": "12.2.0",
    "vitest": "5.0.5"
  }
}
