# Nabd EMQX configuration, mounted at /opt/emqx/etc/base.hocon. Values set later in the dashboard override
# this file; keep everything here so the broker is reproducible.

# Every client authenticates. With an authenticator configured and no match, the connection is refused.
authentication = [
  {
    mechanism = password_based
    backend = built_in_database
    user_id_type = username
    password_hash_algorithm { name = pbkdf2, mac_fun = sha256, iterations = 4096, dk_length = 32 }
    # Generated by `pnpm credentials` (gitignored). Plain passwords are hashed with PBKDF2 on import.
    bootstrap_file = "/opt/emqx/etc/nabd/users.csv"
    bootstrap_type = plain
  }
]

authorization {
  no_match = deny
  deny_action = disconnect
  cache { enable = true, max_size = 64, ttl = 1m }
  sources = [
    { type = file, enable = true, path = "/opt/emqx/etc/nabd-acl/acl.conf" }
  ]
}

mqtt {
  max_packet_size = 4KB
  max_clientid_len = 64
  shared_subscription = true
}
