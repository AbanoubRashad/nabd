{
  "name": "nabd",
  "private": true,
  "description": "Nabd (نبض): real-time IoT monitoring with ESP32 firmware, MQTT, TimescaleDB and a live dashboard.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d emqx timescaledb",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "credentials": "pnpm --filter @nabd/db credentials",
    "db:migrate": "pnpm --filter @nabd/db migrate up",
    "db:seed": "pnpm --filter @nabd/db seed",
    "test:int": "turbo run test:int"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
