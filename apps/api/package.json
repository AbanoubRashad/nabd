{
  "name": "@nabd/api",
  "version": "0.0.0",
  "private": true,
  "description": "REST + WebSocket gateway: auth, live fan-out, command dispatch, alert rules, OTA.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsx src/cli/openapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "@fastify/websocket": "11.3.3",
    "@nabd/db": "workspace:*",
    "@nabd/notify": "workspace:*",
    "@nabd/shared": "workspace:*",
    "@sentry/node": "11.4.0",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "7.0.0",
    "mqtt": "5.16.0",
    "openapi-types": "12.1.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "aedes": "1.2.0",
    "tsx": "4.23.15",
    "ws": "8.22.0"
  }
}
