{
  "name": "@nabd/ingest",
  "version": "0.0.0",
  "private": true,
  "description": "MQTT consumer: validate, batch insert into TimescaleDB, run the rules engine, send notifications.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nabd/shared": "workspace:*",
    "pino": "10.4.0",
    "@nabd/db": "workspace:*",
    "mqtt": "5.16.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
