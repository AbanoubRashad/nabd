{
  "name": "@nabd/demo",
  "version": "0.0.0",
  "private": true,
  "description": "The whole live demo in one process: in-memory broker, the 12 simulated devices, ingest, rules and the API.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nabd/api": "workspace:*",
    "@nabd/ingest": "workspace:*",
    "@nabd/notify": "workspace:*",
    "@nabd/shared": "workspace:*",
    "@nabd/simulator": "workspace:*",
    "aedes": "1.2.0",
    "mqtt": "5.16.0",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
