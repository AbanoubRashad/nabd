{
  "name": "@nabd/simulator",
  "version": "0.0.0",
  "private": true,
  "description": "12 virtual devices that speak the same MQTT protocol as the firmware.",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nabd/db": "workspace:*",
    "@nabd/shared": "workspace:*",
    "mqtt": "5.16.0",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "aedes": "1.2.0",
    "tsx": "4.23.15"
  }
}
