# Copy to .env and fill in. Never commit .env.

# --- databases and broker (infra/docker-compose.yml) ---
POSTGRES_USER=nabd
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://nabd:change-me@localhost:5432/nabd
EMQX_DASHBOARD_PASSWORD=change-me
MQTT_URL=mqtt://localhost:1883

# --- services ---
API_PORT=4000
INGEST_PORT=4100
SIMULATOR_PORT=4200
LOG_LEVEL=info

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# --- error monitoring (leave empty to disable) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- deployment ---
NABD_DOMAIN=
