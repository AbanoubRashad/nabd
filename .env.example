# Copy to .env and fill in. Never commit .env.

# --- databases and broker (infra/docker-compose.yml) ---
POSTGRES_USER=nabd
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://nabd:change-me@localhost:5432/nabd
EMQX_DASHBOARD_PASSWORD=change-me
MQTT_URL=mqtt://localhost:1883
# MQTT passwords for devices and services come from secrets/dev-credentials.json (`pnpm credentials`).
# Point this elsewhere in production.
NABD_CREDENTIALS_FILE=

# --- fleet ---
# The device id of the real ESP32 board. The simulator never publishes as it, and the seed marks it real.
# Leave empty in development so nabd-01 is simulated.
NABD_REAL_DEVICE=
# Simulator: 2 % of commands time out on purpose (set to 0 to turn off).
SIM_COMMAND_TIMEOUT_RATE=0.02

# --- services ---
API_PORT=4000
INGEST_PORT=4100
SIMULATOR_PORT=4200
LOG_LEVEL=info

# --- api ---
# Long random string; required in production (`openssl rand -hex 32`).
JWT_SECRET=
# Comma-separated origins allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:3001
# Optional admin account created by `pnpm db:seed` (password at least 12 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- notifications (leave empty: messages go to the console log) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
RESEND_API_KEY=
ALERT_EMAIL_FROM=

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# --- error monitoring (leave empty to disable) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- deployment ---
NABD_DOMAIN=
